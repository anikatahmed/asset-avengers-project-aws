{
  "name": "auth-server",
  "//HEADER": "npm package manger owns this file. It is read by npm install and npm run. NPM uses dependencies, devDependencies, and scripts ",
  "version": "0.1.0",
  "description": "Registers users and issues JWTs for the trading API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "//start:dev": "this runs nest TSC on current typescript",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "//start:prod": "Runs dist with compiled JS, In prod we would omit devDependencies because that holds compiler and dev dependencies not needed during runtime",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker compose -f ../docker-compose.yml --env-file ../.env up -d auth-db",
    "db:down": "docker compose -f ../docker-compose.yml --env-file ../.env stop auth-db",
    "test:integration": "bash scripts/integration-test.sh",
    "test:sessions": "bash scripts/session-test.sh",
    "email:setup": "node scripts/setup-resend.mjs",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml"
  },
  "//": "Dependencies are given with ranges, npm picks the pinned versions in generated package-lock.json, maven is different because versions are pinned",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
