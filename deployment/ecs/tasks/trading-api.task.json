{
  "family": "asset-avengers-trading-api",
  "requiresCompatibilities": [
    "EC2"
  ],
  "networkMode": "bridge",
  "executionRoleArn": "arn:aws:iam::314662805698:role/asset-avengers-ecs-execution",
  "taskRoleArn": "arn:aws:iam::314662805698:role/asset-avengers-ecs-task",
  "containerDefinitions": [
    {
      "name": "trading-api",
      "image": "314662805698.dkr.ecr.us-east-1.amazonaws.com/asset-avengers/trading-api@sha256:a9e72d1988b602c89dcfb3d591a4b169f3712f6f14f366b724f77333efe75927",
      "essential": true,
      "cpu": 512,
      "memory": 1280,
      "memoryReservation": 768,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:314662805698:secret:matrix/production/credentials-cn8vMu:DB_URL::"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:314662805698:secret:matrix/production/credentials-cn8vMu:DB_USERNAME::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:314662805698:secret:matrix/production/credentials-cn8vMu:DB_PASSWORD::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:314662805698:secret:matrix/production/credentials-cn8vMu:JWT_SECRET::"
        },
        {
          "name": "FAUXNANCE_PRICING_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:314662805698:secret:matrix/production/credentials-cn8vMu:FAUXNANCE_PRICING_API_KEY::"
        }
      ],
      "environment": [
        {
          "name": "DB_DRIVER_CLASS_NAME",
          "value": "org.postgresql.Driver"
        },
        {
          "name": "JWT_ISSUER",
          "value": "endgame-auth"
        },
        {
          "name": "JWT_AUDIENCE",
          "value": "endgame-api"
        },
        {
          "name": "PRICING_API_BASE_URL",
          "value": "https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1"
        },
        {
          "name": "PRICING_API_QUOTES_PATH",
          "value": "/quotes"
        },
        {
          "name": "PRICING_CACHE_TTL",
          "value": "PT15M"
        },
        {
          "name": "PRICING_AUTOMATIC_DAILY_LIMIT",
          "value": "1500"
        },
        {
          "name": "PRICING_TOTAL_DAILY_LIMIT",
          "value": "1800"
        }
      ],
      "stopTimeout": 60,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/asset-avengers",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "service"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/8080; printf \"GET /actuator/health/readiness HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n\" >&3; IFS= read -r status <&3; [[ \"$status\" == *\" 200 \"* ]]"
        ],
        "interval": 15,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "tags": [
    {
      "key": "project",
      "value": "asset-avengers"
    }
  ]
}
